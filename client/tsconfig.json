{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness — relaxed slightly from full strict, see note below */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    /* The existing codebase mixes numbers/strings in form inputs (e.g. reps
       typed from <input type="number"> but held as string until submit), so
       we keep this off rather than scatter `as` casts everywhere for a
       refactor pass. Everything else from `strict` stays on. */
    "allowJs": true,

    "types": ["vite/client"]
  },
  "include": ["src"]
}
