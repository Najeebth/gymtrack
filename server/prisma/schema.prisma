datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MEMBER
  ADMIN
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(MEMBER)
  avatarUrl String?
  createdAt DateTime  @default(now())
  workouts     Workout[]
  templates    Template[]
  exercises    Exercise[]
  chatMessages ChatMessage[]
}

model Workout {
  id          String      @id @default(uuid())
  date        String
  muscleGroup String
  exercise    String
  notes       String?
  createdAt   DateTime    @default(now())
  sets        WorkoutSet[]
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutSet {
  id        String   @id @default(uuid())
  setNumber Int
  reps      Int
  weightKg  Float
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// A saved routine ("Push Day"): an ordered list of exercises, each with its
// default sets stored as JSON: [{ "reps": 10, "weightKg": 60 }, ...].
model Template {
  id        String             @id @default(uuid())
  name      String
  createdAt DateTime           @default(now())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises TemplateExercise[]
}

model TemplateExercise {
  id          String   @id @default(uuid())
  position    Int
  muscleGroup String
  exercise    String
  sets        Json
  templateId  String
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Exercise {
  id          String   @id @default(uuid())
  name        String
  muscleGroup String
  equipment   String
  notes       String?
  isCustom    Boolean  @default(false)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([muscleGroup])
  @@index([userId])
}

enum ChatRole {
  USER
  ASSISTANT
}

// Who produced an assistant reply: a rule-based intent (free), the LLM
// fallback, or a canned fallback when the LLM is unavailable/over quota.
enum ChatSource {
  RULE
  LLM
  FALLBACK
}

// One chat turn. `action` holds a proposed change the user must confirm,
// e.g. { "type": "CREATE_WORKOUT", "draft": { ... } }.
model ChatMessage {
  id        String      @id @default(uuid())
  role      ChatRole
  content   String
  source    ChatSource?
  action    Json?
  createdAt DateTime    @default(now())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
