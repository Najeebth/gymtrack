{
  "name": "gymtrack-backend",
  "version": "1.0.0",
  "description": "Gym Progress Tracker Backend with Traffic Telemetry",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "postinstall": "prisma generate",
    "migrate:dev": "prisma migrate dev",
