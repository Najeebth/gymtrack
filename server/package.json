    "migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
